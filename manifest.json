{
  "manifest_version": 3,
  "name": "MiniFeather Client",
  "version": "3.1.3",
  "description": "MiniFeather for Miniblox",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://miniblox.io/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "src/inject.js",
        "src/mf-freelook.js",
        "src/TitanTiny.js",
        "src/Zoom.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon.png",
        "assets/background.png",
        "assets/Faithful.ttf",
        "assets/memes/gif/*"
      ],
      "matches": [
        "https://miniblox.io/*"
      ]
    }
  ]
}
