{
  "manifest_version": 3,
  "name": "MiniFeather Client",
  "version": "4.6.0",
  "description": "MiniFeather for Miniblox",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://miniblox.io/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "src/SplashScreen.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "src/TextureInterceptor.js",
        "src/CustomSkins.js",
        "src/inject.js",
        "src/FreeCam.js",
        "src/mf-freelook.js",
        "src/ElytraFlight.js",
        "src/TitanTiny.js",
        "src/HealthNameTags.js",
        "src/DistanceNameTags.js",
        "src/PatPat.js",
        "src/ItemPhysics.js",
        "src/NoWeather.js",
        "src/AntiAFK.js",
        "src/Waypoints.js",
        "src/ClientCommands.js",
        "src/Zoom.js",
        "src/Camera Overhaul.js",
        "src/DynamicCrosshair.js",
        "src/Baritone.js",
        "src/Dynamic Crosshair.js",
        "src/features.js",
        "src/armorhud.js",
        "src/MinimapCache.js",
        "src/WorldMap.js",
        "src/RhythmParkour.js",
        "src/VanillaAnimations.js",
        "src/GUIPatch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "src/translations.js",
        "src/jszip.min.js",
        "src/TexturePackManager.js",
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon.png",
        "assets/background.png",
        "assets/Faithful.ttf",
        "assets/memes/gif/*",
        "assets/patpat.png",
        "assets/pat.ogg",
        "assets/pat1.ogg",
        "assets/pat2.ogg",
        "assets/crosshair/*",
        "assets/armor-hud-editor.png",
        "assets/spritesheets generator",
        "assets/frames.json",
        "assets/gui/*",
        "src/jszip.min.js"
      ],
      "matches": [
        "https://miniblox.io/*"
      ]
    }
  ]
}
