{
  "manifest_version": 3,
  "name": "MiniFeatherClient",
  "version": "4.15.5",
  "description": "MiniFeather Client for MiniBlox — movement API resolver for resilient Auto Sprint, Safe Sneak and Anti-AFK, plus Titan & Tiny camera/nametag fixes, FullBright and Realistic V4 Custom.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://miniblox.io/*",
    "https://miniblox.online/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://cdn.modrinth.com/*",
    "https://api.klipy.com/*",
    "https://ntfy.sh/*",
    "https://google.com/*"
  ],
  "background": {
    "service_worker": "src/Core/background.js"
  },
  "sandbox": {
    "pages": ["classic/index.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self'; worker-src 'self' blob:"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/Core/SplashScreen.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/Core/HotLoader.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/Core/HotLoader.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/Chat/FriendNicknames.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/I18n/MainWorldI18n.js",
        "src/I18n/MainTranslations.js",
        "src/I18n/VoiceTranslations.js",
        "src/I18n/CommandTranslations.js",
        "src/Render/TextureInterceptor.js",
        "src/Render/PBRTextures.js",
        "src/Cosmetics/LegacyUnlocks.js",
        "src/Cosmetics/CustomSkins.js",
        "src/Cosmetics/MF_Accounts.js",
        "src/Cosmetics/CustomSkinAPI.js",
        "src/P2P/MF_Mesh.js",
        "src/P2P/MF_VoiceChat.js",
        "src/Core/inject.js",
        "src/UI/NativeSettingsBridge.js",
        "src/Render/FreeCam.js",
        "src/Render/Freelook.js",
        "src/Render/ElytraFlight.js",
        "src/Render/TitanTiny.js",
        "src/Render/HealthNameTags.js",
        "src/Render/DistanceNameTags.js",
        "src/Render/DamageParticles.js",
        "src/Render/WaterSplash.js",
        "src/Render/ShineAmbience.js",
        "src/Render/PatPat.js",
        "src/Render/ItemPhysics.js",
        "src/Render/NoWeather.js",
        "src/Render/FullBright.js",
        "src/Render/LeafWind.js",
        "src/Render/TinyModels.js",
        "src/Render/TinyTakeover.js",
        "src/Experimental/InteractiveVegetation/InteractiveVegetation.js",
        "src/Experimental/Aurora/Aurora.js",
        "src/Experimental/Constellations/Constellations.js",
        "src/Experimental/GrassFlowers/GrassFlowers.js",
        "src/Experimental/FallenLeaves/FallenLeaves.js",
        "src/Experimental/AnimatedItems/AnimatedItems.js",
        "src/Experimental/BetterAnimationCape/BetterAnimationCape.js",
        "src/World/AutoRespawn.js",
        "src/Libraries/brocha.min.js",
        "src/World/IdlePlayerBot.js",
        "src/Movement/MovementAPI.js",
        "src/Movement/AntiAFK.js",
        "src/Movement/MovementAssist.js",
        "src/Waypoints/Waypoints.js",
        "src/Chat/ClientChatIdentity.js",
        "src/Chat/GifChat.js",
        "src/Chat/ClientCommands.js",
        "src/Render/Zoom.js",
        "src/Render/CameraOverhaul.js",
        "src/HUD/DynamicCrosshair.js",
        "src/Movement/Baritone.js",
        "src/Core/features.js",
        "src/HUD/armorhud.js",
        "src/World/MinimapCache.js",
        "src/World/WorldMap.js",
        "src/World/RhythmParkour.js",
        "src/World/LocalGames.js",
        "src/Render/VanillaAnimations.js",
        "src/PlayerAnims/EMFExpr.js",
        "src/PlayerAnims/EMFParser.js",
        "src/PlayerAnims/EMFRuntime.js",
        "src/PlayerAnims/EMFPack.js",
        "src/PlayerAnims/MF_FlySwim.js",
        "src/PlayerAnims/MF_PlayerAnims.js",
        "src/Render/HandSway.js",
        "src/Render/BetterPlayerLayers.js",
        "src/Render/BetterPlayerLayersArmorPatch.js",
        "src/Cosmetics/CustomModels.js",
        "src/Render/DuckMobs.js",
        "src/Render/CrittersMobs.js",
        "src/AI/VerityAI.js",
        "src/Studio/MF_Peer.js",
        "src/Shaders/CustomShader.js",
        "src/Shaders/CustomShaderSafetyPatch.js",
        "src/Experimental/Realistic/RealisticProfiles.js",
        "src/Experimental/Realistic/ShadowSystem.js",
        "src/Experimental/Realistic/ShadowFilterPatch.js",
        "src/Experimental/Realistic/FluidShaderPatch.js",
        "src/Experimental/Realistic/CloudShaderPatch.js",
        "src/Experimental/Realistic/WetnessSystem.js",
        "src/Experimental/Realistic/RenderDistanceSystem.js",
        "src/Experimental/Realistic/RealisticMode.js",
        "src/HUD/GUIPatch.js",
        "src/Cosmetics/Emotes.js",
        "src/Studio/MF_FaceSwap.js",
        "src/Studio/MF_SkinEditor.js",
        "src/Studio/MF_PbrEditor.js",
        "src/Studio/MF_SkinChanger.js",
        "src/Studio/MF_Morph.js",
        "src/Studio/MF_Facial.js",
        "src/Studio/MF_Film.js",
        "src/Studio/MF_FilmCamera.js",
        "src/Studio/MF_Pose.js",
        "src/Studio/MF_Gizmo.js",
        "src/Studio/MF_Animation.js",
        "src/Studio/MF_Timeline.js",
        "src/Studio/MF_Studio.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/P2P/MF_VoiceSignalBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/World/LocalGamesNetworkBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ],
      "js": [
        "src/Chat/ClientChat.js",
        "src/I18n/Translations.js",
        "src/Libraries/jszip.min.js",
        "src/World/MF_WorldImport.js",
        "src/Render/TexturePackManager.js",
        "src/Core/AutoUpdater.js",
        "src/Experimental/ExperimentalRegistry.js",
        "src/UI/TitleScreen.js",
        "src/UI/ClientPanel.js",
        "src/UI/PanelPolish.js",
        "src/UI/InteractionSounds.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "defaults.json",
        "assets/accounts.json",
        "assets/icon.png",
        "assets/background.png",
        "assets/Faithful.ttf",
        "assets/memes/gif/*",
        "assets/patpat.png",
        "assets/particles/water_splash/*",
        "assets/particles/water_splash/*/*",
        "assets/particles/particular/*",
        "assets/particles/shine/*",
        "assets/particles/shine/*/*",
        "assets/particles/shine/*/*/*",
        "assets/tiny/*",
        "assets/tiny/*/*",
        "assets/pat.ogg",
        "assets/pat1.ogg",
        "assets/pat2.ogg",
        "assets/intro.ogg",
        "assets/crosshair/*",
        "assets/armor-hud-editor.png",
        "assets/spritesheets generator",
        "assets/frames.json",
        "assets/pbr/*",
        "assets/gui/*",
        "assets/mfpack/*",
        "assets/pvtexpack.png",
        "assets/shadertextures/*",
        "assets/menu/*",
        "assets/classic/*",
        "assets/garden/*",
        "assets/ui/*",
        "classic/*",
        "classic/*/*",
        "classic/*/*/*",
        "classic/*/*/*/*",
        "classic/*/*/*/*/*",
        "textures/*",
        "textures/*/*",
        "textures/*/*/*",
        "textures/*/*/*/*",
        "assets/content/minifeather-pack/entity/*",
        "models/*",
        "models/*/*",
        "models/*/*/*",
        "emotes/*",
        "skins/*",
        "skins/*/*",
        "skins/*/*/*",
        "src/Libraries/jszip.min.js"
      ],
      "matches": [
        "https://miniblox.io/*",
        "https://miniblox.online/*"
      ]
    }
  ]
}
